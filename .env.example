# Copiá este archivo a .env, o corré `make env`, que además genera las claves.
# Nunca subas el .env al repo.

# --- General ---
APP_ENV=development
# URL desde la que se abre el panel. Los links de login apuntan acá.
PUBLIC_URL=http://localhost
# En producción: tu dominio (ej. app.tudominio.com) para que Caddy saque HTTPS.
SITE_ADDRESS=:80

# --- Postgres (usuario dueño: corre las migraciones) ---
POSTGRES_USER=universia
POSTGRES_PASSWORD=universia

# --- Claves (las genera `make env`) ---
# Cifra los tokens de terceros guardados en la base (Fernet).
ENCRYPTION_KEY=
# Cifra las credenciales guardadas en n8n.
N8N_ENCRYPTION_KEY=

# --- Email del login (en local llega a Mailpit: http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=Universia <hola@example.com>

# Operador interno que crea `make seed`.
SEED_OPERATOR_EMAIL=operador@example.com

# --- LLM (se usa desde la Fase 1) ---
ANTHROPIC_API_KEY=

# --- Almacenamiento S3 (SeaweedFS en local en http://localhost:8333; R2 en producción) ---
S3_ENDPOINT=http://storage:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Observabilidad (opcional) ---
SENTRY_DSN=
LOG_LEVEL=INFO
